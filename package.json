{
  "name": "telop-motion",
  "productName": "TelopMotion",
  "version": "1.0.0",
  "description": "Achievement showcase for Suno profiles",
  "main": "main.js",
  "author": "gadget114514",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "scrape": "node scripts/scrape.js",
    "check": "node scripts/check.js",
    "test": "node --test \"scripts/test/**/*.test.js\"",
    "vendor": "node scripts/vendor.js"
  },
  "build": {
    "appId": "com.gadget114514.telopmotion",
    "productName": "TelopMotion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TelopMotion-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TelopMotion-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "earcut": "^3.2.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "webm-muxer": "^5.1.4"
  }
}
