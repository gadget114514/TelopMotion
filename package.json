{
  "name": "telop-motion",
  "productName": "TelopMotion",
  "version": "1.0.20261006",
  "description": "Achievement showcase for Suno profiles",
  "main": "main.js",
  "author": "gadget114514",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "scrape": "node scripts/scrape.js",
    "fx400": "node scripts/fx400.js",
    "fx800": "node scripts/fx800.js",
    "showcase": "node scripts/showcase.js",
    "figure-showcase": "node scripts/figure-showcase.js",
    "font-showcase": "node scripts/font-showcase.js",
    "backdrop-showcase": "node scripts/backdrop-showcase.js",
    "decor-showcase": "node scripts/decor-showcase.js",
    "theme-showcase": "node scripts/theme-showcase.js",
    "filler-showcase": "node scripts/filler-showcase.js",
    "direct-showcase": "node scripts/direct-showcase.js",
    "camera-showcase": "node scripts/camera-showcase.js",
    "color-showcase": "node scripts/color-showcase.js",
    "clone-showcase": "node scripts/clone-showcase.js",
    "letter-fx-showcase": "node scripts/letter-fx-showcase.js",
    "text-showcase": "node scripts/text-showcase.js",
    "ease-showcase": "node scripts/ease-showcase.js",
    "layer-showcase": "node scripts/layer-showcase.js",
    "demo30": "node scripts/demo30.js build",
    "distinct": "node scripts/distinct-count.js",
    "check": "node scripts/check.js",
    "glcheck": "electron scripts/gl-check.js --no-sandbox",
    "test": "node --test \"scripts/test/**/*.test.js\"",
    "vendor": "node scripts/vendor.js"
  },
  "build": {
    "appId": "com.gadget114514.telopmotion",
    "productName": "TelopMotion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TelopMotion-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TelopMotion-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "earcut": "^3.2.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "three": "^0.186.1",
    "webm-muxer": "^5.1.4"
  }
}
